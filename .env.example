# LLM API Keys (round-robin rotation — at least one of each required)
CLAUDE_API_KEY_1=
CLAUDE_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# News Source API Keys
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
YOUTUBE_API_KEY=

# LLM Model Config (defaults shown)
# CLAUDE_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-2.5-flash
# MAX_TOKENS=4096
# TEMPERATURE=0.2

# RSS Feeds (semicolon-delimited)
# RSS_FEEDS=https://feeds.bloomberg.com/markets/news.rss;https://feeds.reuters.com/reuters/businessNews;https://www.cnbc.com/id/100003114/device/rss/rss.html

# YouTube Channel IDs (semicolon-delimited)
# YOUTUBE_CHANNELS=UCvJJ_dzjViJCoLf5uKUTwoA;UC-EnprmCZ3OXyAoG7539ESA;UCIALMKvObZNtJ68-sMkiRA

# Email Recipients (comma-separated)
EMAIL_RECIPIENTS=
EMAIL_SUBJECT_PREFIX=[Market Mover]

# SMTP Config (Gmail App Password — generate at https://myaccount.google.com/apppasswords)
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# --- Cycle 3 voice + reasoning layer ---
# Briefing persona: vinny | neutral | terminal | villain  (default: vinny)
# BRIEFING_VOICE=vinny
# If profanity is detected in LLM output, fall back to the neutral voice for the day.
# BRIEFING_VOICE_OVERRIDE_TO_NEUTRAL_ON_DETECT=true
# Weekly style mimicry rotation: Mon=0…Sun=6. -1 disables. (default: 2 = Wednesday)
# STYLE_MIMICRY_WEEKDAY=2
# Contrarian "Bear Case" coda (second LLM call). (default: true)
# CONTRARIAN_CODA_ENABLED=true
